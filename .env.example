# ==============================================================================
# ESPRESSO PATRONUM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' and populate with your Supabase credentials:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY NOTICE:
# Never commit '.env.local' or any file containing real secret keys to source control.
# Only '.env.example' should be committed to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public API Credentials (Client-side accessible)
# ------------------------------------------------------------------------------
# Your project URL found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Your project Anon Public API Key (safe for browser client-side use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# 2. Supabase Server / Admin Secret Key (Server-only, NEVER expose to client)
# ------------------------------------------------------------------------------
# Service Role Key for elevated backend tasks, webhooks, or administrative server actions.
# Keep strictly confidential. Bypasses Row Level Security (RLS).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder"

# ------------------------------------------------------------------------------
# 3. Application Metadata & Regional Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Espresso Patronum"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
