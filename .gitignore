# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files & cloud credentials (prevent secret leaks)
.env*
!.env.example
*service-account*.json
*credentials*.json
*.key
*.p12

# ai agent & tool metadata
.agents/
.claude/
.autohand/
skills-lock.json

# ide & editor
.vscode/*
!.vscode/extensions.json
.idea/

# os files
Thumbs.db
ehthumbs.db
Desktop.ini

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
